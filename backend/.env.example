# ---------------------------------------------------------------------------
# NEXORA backend configuration
# Copy this file to `.env` and adjust the values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Database
# SQLite is used by default for zero-config local development.
DATABASE_URL=sqlite:///nexora.sqlite
# To switch to PostgreSQL later, install psycopg and use a URL like:
# DATABASE_URL=postgresql+psycopg://nexora:password@localhost:5432/nexora

# Auth / JWT
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_HOURS=12

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed data: set to False to skip demo records on `flask init-db`
SEED_DEMO_DATA=True
DEMO_ORG_NAME=Vertex Digital Solutions